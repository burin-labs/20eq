import { GameCopy } from "./copy.harn"

pub fn russian_copy() -> GameCopy {
  return {
    locale: "ru",
    language: "Russian",
    intro: [
      "окно чата мерцает и загорается.",
      "курсор мигает, будто",
      "считает твой пульс.",
      "каждый ответ сжигает фитиль.",
    ],
    greeting:
      "о. привет. это ты меня вызвал или я тебя? в любом случае, 20 сообщений, и свеча погаснет. начинай.",
    quit_help: "(введи /quit, чтобы уйти раньше)",
    disconnected: "[связь обрывается]",
    goodbye: "ладно, пока. свеча ревнует.",
    nothing: "(разговор ещё не начался; раскрывать нечего)",
    end_title: "свеча гаснет.",
    reveal: "блокнот hex раскрывается на столе. это её почерк.",
    empty: "[свеча чадит; ответа нет]",
    you: "ты",
    blanks: [
      "хорошая попытка. свеча не считает молчание.",
      "пустое подношение не принято. положи мысль в чашу.",
      "пустота тебя услышала. впечатления не произвело.",
      "нет. многоточия здесь ставлю я.",
      "вопрос останется, пока ты не накормишь его словами.",
    ],
    hints: [
      "свеча склоняется к экрану",
      "под клавишами что-то прислушивается",
      "hex копается в помехах",
      "курсор затаил дыхание",
      "пустота пережёвывает твои слова",
    ],
  }
}

