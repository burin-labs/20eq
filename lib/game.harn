import { agent_private_text_filter } from "std/agent/stream"
import { model_from_env, parse_model_id } from "std/config"
import { GameCopy, english_copy } from "./locale.harn"

pub type HexCallOverrides = {messages?: list, temperature?: float, max_tokens?: int}

pub type HexCallOptions = {
  provider: string,
  model: string,
  thinking: bool,
  messages?: list,
  temperature?: float,
  max_tokens?: int,
}

type HexStreamResult = {ok: bool, text: string, error?: unknown}

pub const MAX_TURNS = 20

pub const SECRET_OPEN = "<secret>"

pub const SECRET_CLOSE = "</secret>"

pub const DEFAULT_MODEL = "local:qwen3.6-35b-a3b-ud-q4-k-xl"

pub fn hex_options(env: HarnessEnv, overrides: HexCallOverrides = {}) -> HexCallOptions {
  const route = parse_model_id(model_from_env(env, "TWENTY_EQ_MODEL", DEFAULT_MODEL))
  return {provider: route.provider, model: route.model, thinking: false} + overrides
}

pub fn strip_secret(text: string) -> string {
  return trim(agent_private_text_filter(text, {open_tag: SECRET_OPEN, close_tag: SECRET_CLOSE}))
}

pub fn expect_hex_stream_text(result: unknown) -> string {
  const response = schema_expect(result, schema_of(HexStreamResult))
  if !response.ok {
    throw response.error ?? "streamed model call failed without an error"
  }
  return response.text
}

pub fn blank_rebuke(turn: int, copy: GameCopy = english_copy()) -> string {
  return copy.blanks[turn % len(copy.blanks)] ?? ""
}

pub fn typing_hint(turn: int, copy: GameCopy = english_copy()) -> string {
  return copy.hints[turn % len(copy.hints)] ?? ""
}

pub fn is_exit_command(text: string) -> bool {
  return text == "/quit" || text == "/exit"
}

pub fn turn_label(turn: int, copy: GameCopy = english_copy()) -> string {
  return "${copy.you} (${turn + 1}/${MAX_TURNS}) > "
}
