import { agent_stream_call } from "std/agent/stream"
import { assert_eq } from "std/testing"
import {
  MAX_TURNS,
  blank_rebuke,
  expect_hex_stream_text,
  hex_options,
  is_exit_command,
  strip_secret,
  turn_label,
  typing_hint,
} from "../lib/game.harn"

pipeline test_private_notebook_never_reaches_visible_text() {
  assert_eq(strip_secret("visible\n<secret>private</secret>"), "visible")
  assert_eq(strip_secret("visible\n<secret>unterminated"), "visible")
  assert_eq(strip_secret("<secret>private</secret>visible"), "visible")
}

pipeline test_harn_stream_boundary_hides_private_notebook(harness: Harness) {
  harness.llm.mock_enqueue({text: "hello from the void<secret>private notes</secret>"})
  let visible = ""
  const result = agent_stream_call(
    harness.llm,
    "",
    "",
    {
      provider: "mock",
      private: {open_tag: "<secret>", close_tag: "</secret>"},
      on_delta: { delta, _event, _state -> visible = visible + delta },
    },
  )
  assert(result.ok)
  assert_eq(visible, "hello from the void")
  assert_eq(result.visible_text, visible)
  assert_eq(result.text, "hello from the void<secret>private notes</secret>")
}

pipeline test_stream_failure_and_empty_success_are_distinct(harness: Harness) {
  harness.llm.mock_enqueue(
    {error: {category: "transient_network", message: "provider unavailable"}},
  )
  const failure = agent_stream_call(harness.llm, "", "", {provider: "mock"})
  const failed = try {
    expect_hex_stream_text(failure)
  }
  assert(is_err(failed))
  const error = unwrap_err(failed)
  assert_eq(error.category, "transient_network")
  assert_eq(error.kind, "transient")
  assert_eq(error.reason, "network_error")
  assert_eq(error.message, "provider unavailable")
  harness.llm.mock_enqueue({text: ""})
  const empty = agent_stream_call(harness.llm, "", "", {provider: "mock"})
  assert_eq(expect_hex_stream_text(empty), "")
}

pipeline test_turn_copy_cycles_without_wall_clock_state() {
  assert_eq(blank_rebuke(0), blank_rebuke(5))
  assert_eq(typing_hint(1), typing_hint(6))
  assert(blank_rebuke(0) != blank_rebuke(1))
}

pipeline test_exit_commands_are_explicit() {
  assert(is_exit_command("/quit"))
  assert(is_exit_command("/exit"))
  assert(!is_exit_command("quit"))
  assert(!is_exit_command("/QUIT"))
}

pipeline test_turn_labels_use_human_numbering() {
  assert_eq(turn_label(0), "you (1/${MAX_TURNS}) > ")
  assert_eq(turn_label(MAX_TURNS - 1), "you (${MAX_TURNS}/${MAX_TURNS}) > ")
}

pipeline test_default_model_route_is_local(harness: Harness) {
  const options = hex_options(harness.env, {temperature: 0.4})
  assert_eq(options.provider, "local")
  assert_eq(options.model, "qwen3.6-35b-a3b-ud-q4-k-xl")
  assert_eq(options.thinking, false)
  assert_eq(options.temperature, 0.4)
}
